# Backend API URL
# Local:   http://localhost:8080
# Dev:     https://<your-railway-dev-url>
# Prod:    https://<your-railway-prod-url>
NEXT_PUBLIC_API_URL=http://localhost:8080

# App environment (development | staging | production)
NEXT_PUBLIC_APP_ENV=development

# Public URL of this frontend (used for metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (NOT NEXT_PUBLIC_): shared secret for the admin BFF. Must
# match the backend's ADMIN_SECRET. Empty = admin disabled.
ADMIN_SECRET=
